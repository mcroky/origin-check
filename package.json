{
  "name": "roky-origin-check",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-notices.mjs && tsc -b && vite build",
    "build:pages": "node scripts/build-notices.mjs && tsc -b && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "validate:ocr": "node scripts/validate-ocr.mjs",
    "api": "tsx --env-file-if-exists=.env.local server/index.ts",
    "check:mfds": "tsx --env-file-if-exists=.env.local scripts/check-mfds.ts"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "4.11.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
